# Copy this file to .env and fill in your real values.
# Find tailnet IPs with `tailscale status` on the Mac mini.
# DO NOT commit your .env file.

# ── Hosts (Tailscale IPs) ─────────────────────────────────────────────────
SPELLMAN_MANOR_IP=100.106.134.96   # Mac mini  — Salem + Hilda + Mailbox
HARVEYS_BIG_GAME_IP=100.79.115.101 # Mac Pro   — Harvey
ZELDAS_LABTOP_IP=100.112.73.96      # MacBook   — Zelda

# ── Familiar gateways (port + bearer token for each) ──────────────────────
# Bearer tokens are operator-scope tokens for OpenClaw's diagnostics endpoint.
# (These are different from the hook tokens below.)
SALEM_GATEWAY_PORT=18789
HILDA_GATEWAY_PORT=18790
ZELDA_GATEWAY_PORT=18789
HARVEY_GATEWAY_PORT=18789

SALEM_GATEWAY_TOKEN=replace-with-salem-operator-token
HILDA_GATEWAY_TOKEN=replace-with-hilda-operator-token
ZELDA_GATEWAY_TOKEN=replace-with-zelda-operator-token
HARVEY_GATEWAY_TOKEN=replace-with-harvey-operator-token

# ── Hook tokens (for cross-familiar messaging via /hooks/agent) ───────────
SALEM_HOOK_TOKEN=replace-with-salem-hook-token
HILDA_HOOK_TOKEN=replace-with-hilda-hook-token
ZELDA_HOOK_TOKEN=replace-with-zelda-hook-token
HARVEY_HOOK_TOKEN=replace-with-harvey-hook-token

# ── Coven Mailbox (Salem's inbox) ─────────────────────────────────────────
MAILBOX_PORT=18792
MAILBOX_TOKEN=replace-with-mailbox-token

# Path to the mailbox files on the Mac mini host.
# Default assumes your home is /Users/sabrinaryan — change if different.
COVEN_MAILBOX_DIR=/Users/sabrinaryan/.openclaw/workspace/coven-mailbox
