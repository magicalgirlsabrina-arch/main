# Copy this file to .env and fill in your real values.
# Find tailnet names with `tailscale status` on Spellman Manor.
# DO NOT commit .env.

HILDA_HOST=hilda.tailXXXX.ts.net
ZELDA_HOST=zelda.tailXXXX.ts.net
SALEM_HOST=salem.tailXXXX.ts.net
HARVEY_HOST=harvey.tailXXXX.ts.net

# OpenClaw gateway operator-scope tokens — one per ClawBot.
HILDA_TOKEN=replace-with-real-token
ZELDA_TOKEN=replace-with-real-token
SALEM_TOKEN=replace-with-real-token
HARVEY_TOKEN=replace-with-real-token
