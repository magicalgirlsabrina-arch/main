# Copy this file to .env and fill in your real values.
# Use Tailscale MagicDNS names (find them with `tailscale status` on the Mac mini).
# DO NOT commit your .env file.

CLAWBOX_1_HOST=clawbox-1.tailXXXX.ts.net
CLAWBOX_2_HOST=clawbox-2.tailXXXX.ts.net
CLAWBOX_3_HOST=clawbox-3.tailXXXX.ts.net
CLAWBOX_4_HOST=clawbox-4.tailXXXX.ts.net

# OpenClaw gateway operator-scope tokens (one per ClawBox).
# Find these in each ClawBox's OpenClaw gateway config.
CLAWBOX_1_TOKEN=replace-with-real-token
CLAWBOX_2_TOKEN=replace-with-real-token
CLAWBOX_3_TOKEN=replace-with-real-token
CLAWBOX_4_TOKEN=replace-with-real-token
