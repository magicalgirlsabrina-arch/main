      "id": 7,
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "increase(coven_mail_sent_total[5m])", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#FFD700" } } },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "type": "stat",
      "title": "Send errors / 5m",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
