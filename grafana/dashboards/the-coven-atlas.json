      "type": "stat",
      "title": "Total messages",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "coven_mailbox_messages_total", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#B19CD9" } } },
