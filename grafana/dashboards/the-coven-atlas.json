      "title": "✨  Activity Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 102, "collapsed": false, "panels": []
    },
    {
      "type": "timeseries",
      "title": "Familiar uptime (last 24h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{
        "expr": "up{familiar!=\"\"}",
        "legendFormat": "{{familiar}}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 0 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "salem" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFD700" } }] },
          { "matcher": { "id": "byName", "options": "hilda" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF6EC7" } }] },
          { "matcher": { "id": "byName", "options": "zelda" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#B19CD9" } }] },
          { "matcher": { "id": "byName", "options": "harvey" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#7EC4FF" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Coven mail traffic",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "rate(coven_mail_sent_total[5m])",        "legendFormat": "sent",   "refId": "A" },
        { "expr": "rate(coven_mail_send_errors_total[5m])", "legendFormat": "errors", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 25, "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "sent" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FFD700" } }] },
          { "matcher": { "id": "byName", "options": "errors" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#FF1493" } }] }
        ]
      }
    },
    {
      "type": "row",
      "title": "🚫  Circuit Breakers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 103, "collapsed": false, "panels": []
    },
    {
      "type": "table",
      "title": "Open circuits per familiar",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "coven_circuit_open", "format": "table", "instant": true, "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "✨ closed (healthy)", "color": "#7EC4FF" }, "1": { "text": "🚫 OPEN", "color": "#FF1493" } } }
          ]
        }
      },
      "options": { "showHeader": true }
    }
