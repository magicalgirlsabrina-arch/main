              { "color": "#FFD700", "value": 0.1 },
              { "color": "#FF1493", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "type": "row",
      "title": "🔮  Per ClawBot — Token Throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
